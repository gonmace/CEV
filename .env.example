# Copiar a .env y rellenar. NUNCA poner valores reales en este archivo:
# .env.example está versionado en un repositorio público.

# ── Proyecto ──────────────────────────────────────────────────────────────────
# Nombre del proyecto (usado en docker-compose y nginx)
PROJECT_NAME=cev

# Dominio de producción (usado por deploy.sh y nginx)
DOMAIN=ejemplo.com

# ── Puertos (consecutivos desde APP_PORT) ─────────────────────────────────────
# Django se expone en APP_PORT. n8n y MCP usan los siguientes.
APP_PORT=8011
N8N_PORT=8012        # Puerto externo para n8n (solo si N8N_DOMAIN está definido)
N8N_MCP_PORT=8013    # Puerto externo para n8n-MCP (solo si N8N_MCP_ENABLED=true)

# ── Django ────────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(64)))"
SECRET_KEY=CAMBIAR-generar-una-clave-aleatoria-de-64-caracteres
DEBUG=False
ALLOWED_HOSTS=ejemplo.com
CSRF_TRUSTED_ORIGINS=https://ejemplo.com
ADMIN_URL=panel/

# Gunicorn (opcional; los defaults del entrypoint son 3/4/150)
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=150

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# POSTGRES_MODE: "container" (por defecto) o "host"
#   - container: PostgreSQL corre en Docker (incluido en docker-compose)
#   - host: PostgreSQL ya instalado en el servidor; contenedores se conectan
#           vía host.docker.internal. Requiere configurar pg_hba.conf manualmente.
POSTGRES_MODE=container
POSTGRES_DB=constructor_ev_db
POSTGRES_USER=constructor_ev_user
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=CAMBIAR-contrasena-aleatoria
POSTGRES_HOST=postgres              # "postgres" para container, "host.docker.internal" para host
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432             # Puerto expuesto en el host (solo dev: DBeaver, etc.)

# ── Redis (cache y sesiones) ───────────────────────────────────────────────────
# Producción: usar nombre del servicio Docker ("redis")
REDIS_URL=redis://redis:6379/0
# Desarrollo nativo (Django en host, Redis en Docker):
# REDIS_URL=redis://localhost:6379/0
REDIS_HOST_PORT=6379

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Si EMAIL_HOST no está definido, se usa el backend de consola.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu@email.com
EMAIL_HOST_PASSWORD=tu-contrasena-de-app
DEFAULT_FROM_EMAIL=noreply@ejemplo.com

# ── n8n (opcional) ────────────────────────────────────────────────────────────
# n8n se habilita definiendo N8N_DOMAIN. Se despliega en su propio subdominio.
# Debe ser DISTINTA de POSTGRES_PASSWORD. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# Ojo: cambiarla invalida las credenciales ya guardadas dentro de n8n (hay que recrearlas).
N8N_ENCRYPTION_KEY=CAMBIAR-clave-hex-de-64-caracteres
N8N_DOMAIN=n8n.ejemplo.com
# OJO: core/settings.py tiene como default el dominio de PRODUCCIÓN para N8N_BASE_URL.
# Definir siempre esta variable en desarrollo para no disparar workflows productivos.
N8N_BASE_URL=https://n8n.ejemplo.com

# ── n8n-MCP (opcional, requiere n8n) ─────────────────────────────────────────
# Servidor MCP sobre HTTP para integrar n8n con Claude Code u otros clientes MCP.
# N8N_MCP_ENABLED=true
# N8N_API_KEY=tu-api-key-de-n8n         # Generado en n8n: Settings > API
# N8N_MCP_AUTH_TOKEN=token-secreto      # Token para autenticar clientes MCP

# ── Google Maps ────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=CAMBIAR

# ── Google OAuth (django-allauth) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=CAMBIAR
GOOGLE_CLIENT_SECRET=CAMBIAR

# ── Sitio ─────────────────────────────────────────────────────────────────────
# URL del logo mostrado en la interfaz (opcional)
SITE_LOGO_URL=
